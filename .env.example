POSTGRES_USER=transporte
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=transporte_escolar
DATABASE_URL=postgresql+psycopg://transporte:troque-esta-senha@db:5432/transporte_escolar
JWT_SECRET=gere-com-openssl-rand-hex-32
APP_ENV=development
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://192.168.1.101:3000
NEXT_PUBLIC_API_URL=http://192.168.1.101:8000

# --- Supabase Auth (somente identidade) ---
# Backend (lido pelo Docker via env_file): endereço do projeto. Dele saem o emissor (iss) e o JWKS.
SUPABASE_URL=https://seu-projeto.supabase.co
# Backend: SÓ preencha se o projeto ainda assina tokens com o segredo legado (HS256).
# Projetos com JWT Signing Keys (ES256/RS256) não precisam. NUNCA use prefixo NEXT_PUBLIC_.
# SUPABASE_JWT_SECRET=
# Frontend (públicas por desenho; a service role key NUNCA entra aqui):
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key
